datasource db {
  provider = "sqlite"
  url      = "file:./data/expenses.db"
}

generator client {
  provider = "prisma-client-js"
}

model Expense {
  id              Int      @id @default(autoincrement())
  telegramUserId  String
  amount          Float
  category        String
  note            String
  transactionDate DateTime
  createdAt       DateTime @default(now())
}

model ShortLink {
  id             Int      @id @default(autoincrement())
  token          String   @unique
  telegramUserId String
  consumed       Boolean  @default(false)
  expiresAt      DateTime
  createdAt      DateTime @default(now())
}
