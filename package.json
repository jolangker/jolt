{
  "name": "jolt",
  "description": "Jolt is a web application built with Nuxt 4, TypeScript, and Tailwind CSS.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:script": "bun server/db/script.ts",
    "docker:build": "docker build -t jolleyx/jolt:latest .",
    "docker:push": "docker push jolleyx/jolt:latest"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.73",
    "@iconify-json/simple-icons": "^1.2.58",
    "@iconify-json/solar": "^1.2.5",
    "@neondatabase/serverless": "^1.0.2",
    "@ngneat/falso": "^8.0.2",
    "@nuxt/ui": "^4.1.0",
    "@unovis/ts": "^1.6.2",
    "@unovis/vue": "^1.6.2",
    "@vueuse/nuxt": "^14.1.0",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.7",
    "drizzle-seed": "^0.3.1",
    "drizzle-zod": "^0.8.3",
    "nuxt": "^4.2.1",
    "nuxt-auth-utils": "^0.5.25",
    "valibot": "^1.1.0",
    "vue": "^3.5.25",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.10.0",
    "drizzle-kit": "^0.31.7",
    "eslint": "^9.39.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.1.3"
  }
}
